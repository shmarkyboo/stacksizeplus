{
	"schemaVersion": 1,
	"id": "stacksizeplus",
	"version": "${version}",
	"name": "Stack Size Plus",
	"description": "Increases the max stack size for specific vanilla items.",
	"authors": [
		"shmark"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/stack-size-plus",
		"sources": "https://github.com/shmarkyboo/stacksizeplus"
	},
	"license": "MIT",
	"icon": "assets/stacksizeplus/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.stacksizeplus.StackSizePlus"
		],
		"client": [
			"com.stacksizeplus.StackSizePlusClient"
		]
	},
	"mixins": [
		"stacksizeplus.mixins.json",
		{
			"config": "stacksizeplus.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}